{
  "name": "xiaoshuo-agent",
  "version": "0.2.0",
  "private": true,
  "description": "小说工坊：本机保存作品、支持长篇阅读与 AI 连续创作的 macOS 桌面应用",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigccc/XiaoShuoAgent.git"
  },
  "homepage": "https://github.com/bigccc/XiaoShuoAgent#readme",
  "bugs": {
    "url": "https://github.com/bigccc/XiaoShuoAgent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "benchmark:recall": "node scripts/benchmark-recall.mjs",
    "benchmark:scenes": "node scripts/benchmark-scenes.mjs",
    "benchmark:structure": "node scripts/benchmark-structure.mjs",
    "benchmark:check-cost": "node scripts/benchmark-check-cost.mjs",
    "benchmark:voice": "node scripts/benchmark-voice.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron out/main/index.js",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:arm64": "npm run make -- --arch=arm64",
    "make:x64": "npm run make -- --arch=x64",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "check": "npm run typecheck && npm test && npm run audit:contrast && npm run build"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0",
    "@electron-forge/maker-base": "8.0.0",
    "@electron-forge/maker-zip": "8.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.6"
  },
  "main": "out/main/index.js",
  "productName": "小说工坊",
  "config": {
    "forge": "./forge.config.mjs"
  }
}
