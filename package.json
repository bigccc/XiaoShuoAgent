{
  "name": "xiaoshuo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron out/main/index.js",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:arm64": "npm run make -- --arch=arm64",
    "make:x64": "npm run make -- --arch=x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0",
    "@electron-forge/maker-base": "8.0.0",
    "@electron-forge/maker-zip": "8.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "main": "out/main/index.js",
  "productName": "小说工坊",
  "config": {
    "forge": "./forge.config.mjs"
  }
}
